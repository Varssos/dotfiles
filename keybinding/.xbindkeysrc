"amixer -D pulse sset Master 5%-"
  m:0x10 + c:82
  Mod2 + KP_Subtract

"amixer -D pulse sset Master 5%+"
  m:0x10 + c:86
  Mod2 + KP_Add

"suspend_sink=$(pactl list short sinks | grep -E 'SUSPENDED|IDLE' | awk '{print $2}') && pactl set-default-sink $suspend_sink"
  m:0x10 + c:63
  Mod2 + KP_Multiply

"amixer -q -D pulse sset Master toggle"
  m:0x10 + c:106
  Mod2 + KP_Divide

"xdotool key F4"
  b:8

"xdotool key F3"
  b:9
